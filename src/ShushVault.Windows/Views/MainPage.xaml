<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="ShushVault.Windows.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ShushVault.Windows.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:ShushVault.Windows.Views"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:WindowTitleBar x:Name="TitleBar" Title="shush vault" />

        <Grid Grid.Row="1" Padding="22" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="Secrets" />
                </StackPanel>
                <Button
                    x:Name="NewSecretButton"
                    Grid.Column="1"
                    MinWidth="104"
                    Content="New secret"
                    Click="OnNewSecretClicked"
                    Style="{StaticResource PrimaryAction}" />
                <Button
                    Grid.Column="2"
                    Margin="8,0,0,0"
                    MinWidth="104"
                    Content="Import .env"
                    Click="OnImportEnvClicked" />
                <Button
                    Grid.Column="3"
                    Margin="8,0,0,0"
                    Width="40"
                    Height="40"
                    Click="OnSettingsClicked">
                    <FontIcon FontSize="16" Glyph="&#xE713;" />
                </Button>
            </Grid>

            <TextBox
                x:Name="SearchBox"
                Grid.Row="1"
                PlaceholderText="Search secrets"
                TextChanged="OnFilterChanged" />

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                <Button x:Name="FilterDevButton" Content="Dev" Click="OnFilterEnvironmentClicked" />
                <Button x:Name="FilterStagingButton" Content="Staging" Click="OnFilterEnvironmentClicked" />
                <Button x:Name="FilterProdButton" Content="Prod" Click="OnFilterEnvironmentClicked" />
                <Button x:Name="FilterAllButton" Content="All" Click="OnFilterEnvironmentClicked" />
            </StackPanel>

            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid
                    Padding="10,8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="130" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontSize="12" FontWeight="SemiBold" Text="Key" />
                    <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold" Text="Value" />
                    <TextBlock Grid.Column="2" FontSize="12" FontWeight="SemiBold" Text="Environment" />
                    <TextBlock Grid.Column="3" FontSize="12" FontWeight="SemiBold" Text="Provider" />
                </Grid>

                <ListView
                    x:Name="SecretsList"
                    Grid.Row="1"
                    ItemsSource="{x:Bind Secrets, Mode=OneWay}"
                    SelectionChanged="OnSecretSelectionChanged"
                    SelectionMode="Single"
                    Visibility="{x:Bind SecretsListVisibility, Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="views:SecretListItem">
                            <Grid Padding="10,10" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="130" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind MaskedValue}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Environment}" />
                                <TextBlock
                                    Grid.Column="3"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Provider}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel
                    x:Name="EmptyState"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Visibility="Collapsed">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="No secrets yet" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Add a secret or import an .env file." />
                </StackPanel>
            </Grid>

            <Grid x:Name="ActionBar" Grid.Row="4" ColumnSpacing="8" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="EditButton" Content="Edit" Click="OnEditClicked" IsEnabled="False" />
                <Button x:Name="CopyButton" Grid.Column="1" Content="Copy value" Click="OnCopyClicked" IsEnabled="False" />
                <Button x:Name="DeleteButton" Grid.Column="2" Content="Delete" Click="OnDeleteClicked" IsEnabled="False" />
                <Button x:Name="ExportButton" Grid.Column="3" Content="Export .env" Click="OnExportClicked" IsEnabled="False" />
                <TextBlock
                    x:Name="StatusText"
                    Grid.Column="4"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="" />
            </Grid>

            <Grid
                x:Name="DialogLayer"
                Grid.Row="0"
                Grid.RowSpan="5"
                Background="#D9050505"
                Visibility="Collapsed">
                <Border
                    x:Name="SecretDialog"
                    Width="430"
                    Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource ModalSurfaceBrush}"
                    BorderBrush="{StaticResource ModalBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="Collapsed">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="SecretDialogTitle" FontWeight="SemiBold" Text="New Secret" />
                        <ComboBox
                            x:Name="WorkspaceBox"
                            Width="145"
                            HorizontalAlignment="Left"
                            PlaceholderText="Workspace"
                            SelectedIndex="0"
                            SelectionChanged="OnWorkspaceSelectionChanged">
                                <ComboBoxItem Content="Default" />
                                <ComboBoxItem Content="Add workspace..." />
                        </ComboBox>
                        <TextBox x:Name="NameBox" PlaceholderText="Key (e.g. OPENAI_API_KEY)" />
                        <PasswordBox x:Name="ValueBox" PlaceholderText="Secret value" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ToggleButton x:Name="DevToggle" Content="Dev" IsChecked="True" Click="OnSecretEnvironmentClicked" />
                            <ToggleButton x:Name="StagingToggle" Content="Staging" Click="OnSecretEnvironmentClicked" />
                            <ToggleButton x:Name="ProdToggle" Content="Prod" Click="OnSecretEnvironmentClicked" />
                        </StackPanel>
                        <TextBox x:Name="ProviderBox" PlaceholderText="Provider (optional)" />
                        <TextBox x:Name="NotesBox" PlaceholderText="Notes (optional)" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="1" Content="Cancel" Click="OnCloseDialogClicked" />
                            <Button x:Name="SaveButton" Grid.Column="2" Content="Save" Click="OnSaveClicked" Style="{StaticResource PrimaryAction}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border
                    x:Name="ImportDialog"
                    Width="740"
                    Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource ModalSurfaceBrush}"
                    BorderBrush="{StaticResource ModalBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="Collapsed">
                    <StackPanel Spacing="10">
                        <TextBlock FontWeight="SemiBold" Text="Import .env" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ImportWorkspaceBox" PlaceholderText="Workspace" SelectedIndex="0">
                                <ComboBoxItem Content="Default" />
                            </ComboBox>
                            <ComboBox x:Name="ConflictBox" Grid.Column="1" SelectedIndex="0">
                                <ComboBoxItem Content="Skip" />
                                <ComboBoxItem Content="Overwrite" />
                                <ComboBoxItem Content="Rename" />
                            </ComboBox>
                            <TextBox x:Name="ImportProviderBox" Grid.Column="2" PlaceholderText="Provider (optional, applied to imported rows)" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ToggleButton x:Name="ImportDevToggle" Content="Dev" IsChecked="True" Click="OnImportEnvironmentClicked" />
                            <ToggleButton x:Name="ImportStagingToggle" Content="Staging" Click="OnImportEnvironmentClicked" />
                            <ToggleButton x:Name="ImportProdToggle" Content="Prod" Click="OnImportEnvironmentClicked" />
                        </StackPanel>
                        <TextBox
                            x:Name="EnvImportBox"
                            AcceptsReturn="True"
                            MinHeight="150"
                            PlaceholderText="Paste KEY=value lines"
                            TextChanged="OnEnvImportTextChanged"
                            TextWrapping="Wrap" />
                        <TextBlock FontWeight="SemiBold" Text="Preview" />
                        <ListView MaxHeight="170" ItemsSource="{x:Bind ImportPreview, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="views:ImportPreviewListItem">
                                    <Grid Padding="8,5" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Line}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Key}" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind MaskedValue}" />
                                        <TextBlock Grid.Column="3" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Status}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="1" Content="Cancel" Click="OnCloseDialogClicked" />
                            <Button Grid.Column="2" Content="Import" Click="OnImportClicked" Style="{StaticResource PrimaryAction}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border
                    x:Name="WorkspaceDialog"
                    Width="360"
                    Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource ModalSurfaceBrush}"
                    BorderBrush="{StaticResource ModalBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="Collapsed">
                    <StackPanel Spacing="10">
                        <TextBlock FontWeight="SemiBold" Text="New Workspace" />
                        <TextBox x:Name="NewWorkspaceBox" PlaceholderText="Workspace name" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="1" Content="Cancel" Click="OnCancelWorkspaceClicked" />
                            <Button Grid.Column="2" Content="Create" Click="OnCreateWorkspaceClicked" Style="{StaticResource PrimaryAction}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
