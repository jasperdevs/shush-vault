<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="ShushVault.Windows.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:ShushVault.Windows.Views"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="TitleBarDragRegion"
            Padding="16,0,138,0"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Width="22" Height="22" Source="ms-appx:///Assets/Square44x44Logo.scale-200.png" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Text="shush vault" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="28,18,28,24" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="24"
                    FontWeight="SemiBold"
                    Text="secrets" />
                <TextBlock
                    x:Name="VaultStateText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Locked" />
            </Grid>

            <Grid Grid.Row="1" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="132" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="SearchBox"
                    PlaceholderText="Search secrets"
                    TextChanged="OnFilterChanged" />
                <TextBox
                    x:Name="WorkspaceFilterBox"
                    Grid.Column="1"
                    PlaceholderText="Workspace"
                    TextChanged="OnFilterChanged" />
                <ComboBox
                    x:Name="EnvironmentFilterBox"
                    Grid.Column="2"
                    SelectedIndex="0"
                    SelectionChanged="OnFilterChanged">
                    <ComboBoxItem Content="All" />
                    <ComboBoxItem Content="Dev" />
                    <ComboBoxItem Content="Staging" />
                    <ComboBoxItem Content="Prod" />
                </ComboBox>
            </Grid>

            <ListView
                x:Name="SecretsList"
                Grid.Row="2"
                ItemsSource="{x:Bind Secrets, Mode=OneWay}"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="views:SecretListItem">
                        <Grid Padding="14,12" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="170" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind MaskedValue}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind Workspace}" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{x:Bind Environment}" />
                            <TextBlock
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Provider}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid Grid.Row="3" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="Edit" Click="OnEditClicked" />
                <Button Grid.Column="1" Content="Copy value" Click="OnCopyClicked" />
                <Button Grid.Column="2" Content="Delete" Click="OnDeleteClicked" />
                <Button Grid.Column="3" Content="Export .env" Click="OnExportClicked" />
                <TextBlock
                    x:Name="StatusText"
                    Grid.Column="4"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="No secrets saved yet." />
            </Grid>

            <Expander Grid.Row="4" Header="Settings">
                <StackPanel Padding="0,12,0,0" Spacing="10">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox
                            x:Name="PassphraseBox"
                            PlaceholderText="Vault passphrase" />
                        <Button
                            Grid.Column="1"
                            Content="Unlock"
                            Click="OnUnlockClicked" />
                        <Button
                            Grid.Column="2"
                            Content="Lock"
                            Click="OnLockClicked" />
                        <TextBlock
                            x:Name="VaultPathText"
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="PlatformUnlockButton"
                            Content="Use Windows Hello"
                            Click="OnPlatformUnlockClicked" />
                        <Button
                            x:Name="SavePlatformUnlockButton"
                            Grid.Column="1"
                            Content="Save for Windows Hello"
                            Click="OnSavePlatformUnlockClicked" />
                        <Button
                            x:Name="RemovePlatformUnlockButton"
                            Grid.Column="2"
                            Content="Remove saved unlock"
                            Click="OnRemovePlatformUnlockClicked" />
                        <TextBlock
                            x:Name="PlatformUnlockStatus"
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Checking platform unlock..." />
                    </Grid>
                </StackPanel>
            </Expander>

            <Expander Grid.Row="5" Header="Edit or import">
                <Grid Padding="0,12,0,0" ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="WorkspaceBox" Header="Workspace" Text="Default" />
                            <ComboBox x:Name="EnvironmentBox" Grid.Column="1" Header="Environment" SelectedIndex="0">
                                <ComboBoxItem Content="Dev" />
                                <ComboBoxItem Content="Staging" />
                                <ComboBoxItem Content="Prod" />
                            </ComboBox>
                        </Grid>
                        <TextBox x:Name="NameBox" Header="Key" PlaceholderText="OPENAI_API_KEY" />
                        <PasswordBox x:Name="ValueBox" Header="Value" PlaceholderText="paste a token or key" />
                        <TextBox x:Name="ProviderBox" Header="Provider" PlaceholderText="OpenAI, Stripe, Vercel" />
                        <TextBox
                            x:Name="NotesBox"
                            Header="Notes"
                            AcceptsReturn="True"
                            MinHeight="72"
                            TextWrapping="Wrap" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="SaveButton"
                                Content="Save"
                                Click="OnSaveClicked"
                                Style="{StaticResource PrimaryAction}" />
                            <Button
                                Grid.Column="1"
                                Content="Clear"
                                Click="OnClearClicked" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="10">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <Button Content="Choose .env" Click="OnChooseEnvClicked" />
                            <ComboBox x:Name="ConflictBox" Grid.Column="1" SelectedIndex="0">
                                <ComboBoxItem Content="Skip" />
                                <ComboBoxItem Content="Overwrite" />
                                <ComboBoxItem Content="Rename" />
                            </ComboBox>
                        </Grid>
                        <TextBox
                            x:Name="EnvImportBox"
                            AcceptsReturn="True"
                            MinHeight="112"
                            PlaceholderText="Paste KEY=value lines"
                            TextChanged="OnEnvImportTextChanged"
                            TextWrapping="Wrap" />
                        <Button Content="Import previewed entries" Click="OnImportClicked" />
                        <ListView
                            MaxHeight="142"
                            ItemsSource="{x:Bind ImportPreview, Mode=OneWay}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="views:ImportPreviewListItem">
                                    <Grid Padding="8,5" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="86" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Line}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Key}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind Status}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Grid>
            </Expander>
        </Grid>
    </Grid>
</Page>
