<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="ShushVault.Windows.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ShushVault.Windows.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:ShushVault.Windows.Views"
    Background="Transparent"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:WindowTitleBar x:Name="TitleBar" Title="Secrets" />

        <Grid Grid.Row="1" Padding="24,4,24,16" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top row: env pills (left) + action buttons (right) -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Style="{StaticResource HeroTitle}"
                    Text="Secrets" />
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button x:Name="NewSecretButton" Click="OnNewSecretClicked" Style="{StaticResource PrimaryAction}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="13" Glyph="&#xE710;" />
                            <TextBlock Text="New secret" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnImportEnvClicked" Style="{StaticResource Action}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="13" Glyph="&#xE8E5;" />
                            <TextBlock Text="Import .env" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnSettingsClicked" Style="{StaticResource Action}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="13" Glyph="&#xE713;" />
                            <TextBlock Text="Settings" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Search bar + env dropdown -->
            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid
                    Height="40"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    CornerRadius="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Margin="14,0,8,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE721;" />
                    <TextBox
                        x:Name="SearchBox"
                        Grid.Column="1"
                        MinHeight="0"
                        Padding="0,0,12,0"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="14"
                        PlaceholderText="Search secrets"
                        TextChanged="OnFilterChanged">
                        <TextBox.Resources>
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                        </TextBox.Resources>
                    </TextBox>
                </Grid>
                <ComboBox
                    x:Name="EnvFilterBox"
                    Grid.Column="1"
                    Height="40"
                    MinWidth="140"
                    CornerRadius="8"
                    SelectionChanged="OnEnvFilterChanged">
                    <ComboBoxItem Content="All envs" Tag="All" IsSelected="True" />
                    <ComboBoxItem Content="Dev" Tag="Dev" />
                    <ComboBoxItem Content="Staging" Tag="Staging" />
                    <ComboBoxItem Content="Prod" Tag="Prod" />
                </ComboBox>
            </Grid>

            <!-- Table header -->
            <Grid Grid.Row="2" Padding="14,4,14,4" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="118" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Style="{StaticResource SectionLabel}" Text="Key" />
                <TextBlock Grid.Column="2" Style="{StaticResource SectionLabel}" Text="Value" />
                <TextBlock Grid.Column="3" Style="{StaticResource SectionLabel}" Text="Environment" />
            </Grid>

            <!-- Table body -->
            <Grid Grid.Row="3">
                <Border
                    Background="{ThemeResource CardSurfaceBrush}"
                    BorderBrush="{ThemeResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <Grid>
                        <ScrollViewer
                            x:Name="SecretsScroll"
                            HorizontalScrollMode="Disabled"
                            VerticalScrollBarVisibility="Auto"
                            Visibility="{x:Bind SecretsListVisibility, Mode=OneWay}">
                            <ItemsControl ItemsSource="{x:Bind Secrets, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="0" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="views:SecretListItem">
                                        <Grid
                                            Background="Transparent"
                                            Loaded="OnRowLoaded"
                                            PointerEntered="OnRowPointerEntered"
                                            PointerExited="OnRowPointerExited"
                                            Tag="{x:Bind Id}"
                                            Tapped="OnRowTapped">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="1" />
                                            </Grid.RowDefinitions>
                                            <Grid Padding="14,11" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="118" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    Width="28"
                                                    Height="28"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Background="{ThemeResource AvatarSurfaceBrush}"
                                                    CornerRadius="6">
                                                    <Grid>
                                                        <Image
                                                            Width="20"
                                                            Height="20"
                                                            Source="{x:Bind IconSource}"
                                                            Visibility="{x:Bind IconVisibility}" />
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="13"
                                                            FontWeight="SemiBold"
                                                            Foreground="{ThemeResource AvatarTextBrush}"
                                                            Text="{x:Bind Initial}"
                                                            Visibility="{x:Bind InitialVisibility}" />
                                                    </Grid>
                                                </Border>
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    FontFamily="Cascadia Code, Consolas, Segoe UI"
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind Name}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    FontFamily="Cascadia Code, Consolas"
                                                    FontSize="13"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind MaskedValue}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Grid.Column="3"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind Environment}" />
                                                <StackPanel
                                                    Grid.Column="4"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="2">
                                                    <Button
                                                        Click="OnRowCopyClicked"
                                                        Style="{StaticResource QuietIconButton}"
                                                        Tag="{x:Bind Id}"
                                                        ToolTipService.ToolTip="Copy value">
                                                        <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                                                    </Button>
                                                    <Button
                                                        Click="OnRowEditClicked"
                                                        Style="{StaticResource QuietIconButton}"
                                                        Tag="{x:Bind Id}"
                                                        ToolTipService.ToolTip="Edit">
                                                        <FontIcon FontSize="14" Glyph="&#xE70F;" />
                                                    </Button>
                                                    <Button
                                                        Click="OnRowDeleteClicked"
                                                        Style="{StaticResource QuietIconButton}"
                                                        Tag="{x:Bind Id}"
                                                        ToolTipService.ToolTip="Delete">
                                                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                            <Border Grid.Row="1" Background="{ThemeResource DividerBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel
                            x:Name="EmptyState"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="10"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="EmptyTitle"
                                HorizontalAlignment="Center"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="No secrets" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Modal layer -->
            <Grid
                x:Name="DialogLayer"
                Grid.Row="0"
                Grid.RowSpan="4"
                Background="{ThemeResource ModalScrimBrush}"
                Visibility="Collapsed">
                <Border
                    x:Name="SecretDialog"
                    Width="540"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource ModalSurfaceBrush}"
                    BorderBrush="{StaticResource ModalBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Visibility="Collapsed">
                    <StackPanel Spacing="14">
                        <TextBlock x:Name="SecretDialogTitle" FontSize="16" FontWeight="SemiBold" Text="New secret" />
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource SectionLabel}" Text="Website (icon is auto-fetched from favicon)" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="WebsiteBox"
                                    VerticalAlignment="Stretch"
                                    PlaceholderText="https://stripe.com"
                                    TextChanged="OnWebsiteChanged" />
                                <Border
                                    x:Name="IconDropZone"
                                    Grid.Column="1"
                                    Width="36"
                                    Height="36"
                                    AllowDrop="True"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    DragOver="OnIconDragOver"
                                    Drop="OnIconDrop"
                                    Tapped="OnIconBrowseClicked"
                                    ToolTipService.ToolTip="Drop or click to override icon">
                                    <Grid>
                                        <FontIcon
                                            x:Name="IconHint"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Glyph="&#xE722;" />
                                        <Image
                                            x:Name="IconPreview"
                                            Width="22"
                                            Height="22"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource SectionLabel}" Text="Key" />
                            <TextBox x:Name="NameBox" FontFamily="Cascadia Code, Consolas" PlaceholderText="OPENAI_API_KEY" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource SectionLabel}" Text="Value" />
                            <PasswordBox x:Name="ValueBox" FontFamily="Cascadia Code, Consolas" PlaceholderText="Secret value" />
                        </StackPanel>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock Style="{StaticResource SectionLabel}" Text="Workspace" />
                                <ComboBox
                                    x:Name="WorkspaceBox"
                                    HorizontalAlignment="Stretch"
                                    SelectedIndex="0"
                                    SelectionChanged="OnWorkspaceSelectionChanged">
                                    <ComboBoxItem Content="Default" />
                                    <ComboBoxItem Content="Add workspace" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Style="{StaticResource SectionLabel}" Text="Environment" />
                                <ComboBox
                                    x:Name="EnvironmentBox"
                                    HorizontalAlignment="Stretch"
                                    SelectedIndex="0"
                                    SelectionChanged="OnSecretEnvironmentChanged">
                                    <ComboBoxItem Content="Dev" />
                                    <ComboBoxItem Content="Staging" />
                                    <ComboBoxItem Content="Prod" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource SectionLabel}" Text="Provider (optional)" />
                            <TextBox x:Name="ProviderBox" PlaceholderText="OpenAI, Stripe" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource SectionLabel}" Text="Notes (optional)" />
                            <TextBox x:Name="NotesBox" AcceptsReturn="True" PlaceholderText="" TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid ColumnSpacing="8" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="1" Click="OnCloseDialogClicked" Content="Cancel" Style="{StaticResource Action}" />
                            <Button x:Name="SaveButton" Grid.Column="2" Click="OnSaveClicked" Content="Save" Style="{StaticResource PrimaryAction}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border
                    x:Name="ImportDialog"
                    Width="780"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource ModalSurfaceBrush}"
                    BorderBrush="{StaticResource ModalBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Visibility="Collapsed">
                    <StackPanel Spacing="14">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Import .env" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock Style="{StaticResource SectionLabel}" Text="Workspace" />
                                <ComboBox x:Name="ImportWorkspaceBox" HorizontalAlignment="Stretch" SelectedIndex="0">
                                    <ComboBoxItem Content="Default" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Style="{StaticResource SectionLabel}" Text="Environment" />
                                <ComboBox
                                    x:Name="ImportEnvironmentBox"
                                    HorizontalAlignment="Stretch"
                                    SelectedIndex="0"
                                    SelectionChanged="OnImportEnvironmentChanged">
                                    <ComboBoxItem Content="Dev" />
                                    <ComboBoxItem Content="Staging" />
                                    <ComboBoxItem Content="Prod" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="6">
                                <TextBlock Style="{StaticResource SectionLabel}" Text="Provider (optional)" />
                                <TextBox x:Name="ImportProviderBox" PlaceholderText="OpenAI, Stripe" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Spacing="6">
                                <TextBlock Style="{StaticResource SectionLabel}" Text="On conflict" />
                                <ComboBox x:Name="ConflictBox" HorizontalAlignment="Stretch" SelectedIndex="0">
                                    <ComboBoxItem Content="Skip" />
                                    <ComboBoxItem Content="Overwrite" />
                                    <ComboBoxItem Content="Rename" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <TextBox
                            x:Name="EnvImportBox"
                            MinHeight="160"
                            AcceptsReturn="True"
                            FontFamily="Cascadia Code, Consolas"
                            PlaceholderText="API_KEY=sk-..."
                            TextChanged="OnEnvImportTextChanged"
                            TextWrapping="Wrap" />
                        <ListView MaxHeight="180" ItemsSource="{x:Bind ImportPreview, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="views:ImportPreviewListItem">
                                    <Grid Padding="6,5" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind Line}" />
                                        <TextBlock Grid.Column="1" FontFamily="Cascadia Code, Consolas" Text="{x:Bind Key}" />
                                        <TextBlock Grid.Column="2" FontFamily="Cascadia Code, Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind MaskedValue}" />
                                        <TextBlock Grid.Column="3" FontWeight="SemiBold" Foreground="{x:Bind StatusForeground}" Text="{x:Bind Status}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="1" Click="OnCloseDialogClicked" Content="Cancel" Style="{StaticResource Action}" />
                            <Button Grid.Column="2" Click="OnImportClicked" Content="Import" Style="{StaticResource PrimaryAction}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border
                    x:Name="WorkspaceDialog"
                    Width="380"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource ModalSurfaceBrush}"
                    BorderBrush="{StaticResource ModalBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="New workspace" />
                        <TextBox x:Name="NewWorkspaceBox" PlaceholderText="e.g. my-app, client-a" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="1" Click="OnCancelWorkspaceClicked" Content="Cancel" Style="{StaticResource Action}" />
                            <Button Grid.Column="2" Click="OnCreateWorkspaceClicked" Content="Create" Style="{StaticResource PrimaryAction}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
