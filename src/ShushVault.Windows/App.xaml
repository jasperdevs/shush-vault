<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="ShushVault.Windows.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ShushVault.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#F4F4F4" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E2E2E2" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CFCFCF" />
                    <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#3A3A3A" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#0F0F0F" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#0F0F0F" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="#7A7A7A" />
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#E5E5E5" />
                    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#BFBFBF" />
                    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#A0A0A0" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#0F0F0F" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#1F1F1F" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#2A2A2A" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <x:Double x:Key="AppFontSize">14</x:Double>
            <x:Double x:Key="ControlRowHeight">40</x:Double>
            <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>

            <Style x:Key="HeroTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextLineBounds" Value="Tight" />
            </Style>

            <Style x:Key="MutedSubtitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="SectionLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="Action" TargetType="Button">
                <Setter Property="FontSize" Value="{StaticResource AppFontSize}" />
                <Setter Property="Padding" Value="14,9" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <Style x:Key="PrimaryAction"
                   TargetType="Button"
                   BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="FontSize" Value="{StaticResource AppFontSize}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="14,9" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <Style x:Key="QuietIconButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
            </Style>

            <Style x:Key="EnvPill" TargetType="Button">
                <Setter Property="FontSize" Value="{StaticResource AppFontSize}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="14,9" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="MinWidth" Value="78" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="{ThemeResource PillRestBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource PillRestForegroundBrush}" />
            </Style>

            <SolidColorBrush x:Key="PageBackgroundBrush" Color="#161616" />
            <SolidColorBrush x:Key="ModalScrimBrush" Color="#0F0F0F" />
            <SolidColorBrush x:Key="ModalSurfaceBrush" Color="#1F1F1F" />
            <SolidColorBrush x:Key="ModalBorderBrush" Color="#2D2D2D" />
            <SolidColorBrush x:Key="CardSurfaceBrush" Color="#1C1C1C" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#262626" />
            <SolidColorBrush x:Key="RowHoverBrush" Color="#202020" />
            <SolidColorBrush x:Key="DividerBrush" Color="#242424" />
            <SolidColorBrush x:Key="PillRestBrush" Color="#1E1E1E" />
            <SolidColorBrush x:Key="PillActiveBrush" Color="#F4F4F4" />
            <SolidColorBrush x:Key="PillRestForegroundBrush" Color="#C8C8C8" />
            <SolidColorBrush x:Key="PillActiveForegroundBrush" Color="#0F0F0F" />
            <SolidColorBrush x:Key="AvatarSurfaceBrush" Color="#262626" />
            <SolidColorBrush x:Key="AvatarTextBrush" Color="#E5E5E5" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
